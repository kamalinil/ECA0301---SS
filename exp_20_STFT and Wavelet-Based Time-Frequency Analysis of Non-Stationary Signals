clc;
clear;
close all;

% Sampling frequency
Fs = 1000;

% Time vector
t = 0:1/Fs:2-1/Fs;

% Non-stationary input:
% Linear chirp from 50 Hz to 300 Hz
x = chirp(t, 50, t(end), 300, 'linear');

% Generate transient burst
burst = zeros(size(t));

% Burst duration: 0.8 s to 1.0 s
idx = (t >= 0.8) & (t <= 1.0);

% 150 Hz sinusoidal burst with amplitude 0.8
burst(idx) = 0.8 * sin(2*pi*150*t(idx));

% Add transient burst to chirp
x = x + burst;

% ---------------------------------------------------------
% STFT / Spectrogram
% ---------------------------------------------------------

% Hann window
win = hann(128, 'periodic');

% Number of overlapping samples
noverlap = 112;

% FFT length
nfft = 512;

% Compute STFT
[S, F, Tstft] = spectrogram(x, win, noverlap, nfft, Fs);

% ---------------------------------------------------------
% Plot results
% ---------------------------------------------------------

figure('Name', 'Experiment 20: STFT and Wavelet Analysis');

% Input signal
subplot(3,1,1);
plot(t, x);
grid on;
xlabel('Time (s)');
ylabel('Amplitude');
title('Input: Chirp with 150 Hz Transient');

% STFT magnitude spectrogram
subplot(3,1,2);
imagesc(Tstft, F, 20*log10(abs(S) + eps));
axis xy;
ylim([0 400]);
colorbar;
xlabel('Time (s)');
ylabel('Frequency (Hz)');
title('STFT Magnitude Spectrogram (dB)');

% ---------------------------------------------------------
% Continuous Wavelet Transform
% Requires Wavelet Toolbox
% ---------------------------------------------------------

[wt, fCWT] = cwt(x, Fs);

% CWT magnitude scalogram
subplot(3,1,3);
imagesc(t, fCWT, abs(wt));
axis xy;
ylim([0 400]);
colorbar;
xlabel('Time (s)');
ylabel('Frequency (Hz)');
title('CWT Magnitude Scalogram');

% ---------------------------------------------------------
% Display settings
% ---------------------------------------------------------

fprintf('Sampling frequency = %d Hz\n', Fs);

fprintf(['STFT window = %d samples; overlap = %d samples; ' ...
         'FFT length = %d\n'], ...
         length(win), noverlap, nfft);

fprintf(['Input contains a chirp from 50 Hz to 300 Hz and a ' ...
         '150 Hz burst from 0.8 to 1.0 s.\n']);
